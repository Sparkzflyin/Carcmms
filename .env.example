# From Supabase: Project Settings → API (or `vercel env pull` if you added
# Supabase through the Vercel Marketplace).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either key works. New projects issue a publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
